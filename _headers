# Cloudflare Pages _headers file
# This configures headers for your site

# Allow scripts from same origin and inline scripts
/*
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.omniva.lt; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';

# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML files - no cache
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker - must not be cached
/service-worker.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
